#!/usr/bin/env bash

# auto-cpufreq-installer:
# auto-cpufreq source code based installer

cd "$(dirname "$(readlink -f "$0")")" || exit 1

COLOUMNS="`tput cols`"
MID="$((COLOUMNS / 2))"

APPLICATIONS_PATH="/usr/share/applications"
VENV_PATH="/opt/auto-cpufreq"
POWER_STATE_SNAPSHOT="/var/lib/auto-cpufreq/power-state.json"
OPERATION_LOCK_PATH="/run/lock/auto-cpufreq.lock"
CPUFREQCTL_FILE="/usr/local/bin/cpufreqctl.auto-cpufreq"
AUTO_CPUFREQ_STATS_FILE="/var/run/auto-cpufreq.stats"

SHARE_DIR="/usr/local/share/auto-cpufreq/"

AUTO_CPUFREQ_FILE="/usr/local/bin/auto-cpufreq"
AUTO_CPUFREQ_GTK_FILE=$AUTO_CPUFREQ_FILE-gtk
AUTO_CPUFREQ_GTK_DESKTOP_FILE="$(basename "$AUTO_CPUFREQ_GTK_FILE").desktop"

IMG_FILE="/usr/share/pixmaps/auto-cpufreq.png"
ORG_FILE="/usr/share/polkit-1/actions/org.auto-cpufreq.pkexec.policy"

function header {
  echo
  printf "%0.s─" $(seq $((MID-(${#1}/2)-2)))
  printf " $1 "
  printf "%0.s─" $(seq $((MID-(${#1}/2)-2)))
  echo; echo
}

function ask_operation {
  header "auto-cpufreq installer"
  echo "Welcome to auto-cpufreq tool installer."; echo
  read -p "Select a key [I]nstall/[R]emove or press ctrl+c to quit: " answer
}

function acquire_operation_lock {
  local inherited_fd="${AUTO_CPUFREQ_OPERATION_LOCK_FD:-}"
  local inherited_path
  local expected_path

  if ! command -v flock > /dev/null 2>&1; then
    echo "Error: flock from util-linux is required to coordinate auto-cpufreq operations."
    return 1
  fi

  if [ -n "$inherited_fd" ]; then
    case "$inherited_fd" in
      *[!0-9]*|'')
        echo "Error: The inherited auto-cpufreq operation lock is invalid."
        return 1
        ;;
    esac

    if [ ! -e "/proc/$$/fd/$inherited_fd" ]; then
      echo "Error: The inherited auto-cpufreq operation lock is invalid."
      return 1
    fi

    inherited_path="$(readlink -f "/proc/$$/fd/$inherited_fd")" || {
      echo "Error: The inherited auto-cpufreq operation lock is invalid."
      return 1
    }
    expected_path="$(readlink -f "$OPERATION_LOCK_PATH")" || {
      echo "Error: Unable to resolve the auto-cpufreq operation lock path."
      return 1
    }

    if [ "$inherited_path" != "$expected_path" ]; then
      echo "Error: The inherited auto-cpufreq operation lock does not match $OPERATION_LOCK_PATH."
      return 1
    fi

    if ! flock -n "$inherited_fd"; then
      echo "Error: The inherited auto-cpufreq operation lock is not held."
      return 1
    fi

    OPERATION_LOCK_FD="$inherited_fd"
  else
    if ! mkdir -p "$(dirname "$OPERATION_LOCK_PATH")"; then
      echo "Error: Unable to create the auto-cpufreq operation lock directory."
      return 1
    fi

    if ! exec {OPERATION_LOCK_FD}>"$OPERATION_LOCK_PATH"; then
      echo "Error: Unable to open the auto-cpufreq operation lock."
      return 1
    fi
    if ! chmod 600 "$OPERATION_LOCK_PATH"; then
      echo "Error: Unable to secure the auto-cpufreq operation lock."
      exec {OPERATION_LOCK_FD}>&-
      return 1
    fi
    if ! flock -n "$OPERATION_LOCK_FD"; then
      echo "Error: Another auto-cpufreq source installer operation is already in progress."
      exec {OPERATION_LOCK_FD}>&-
      return 1
    fi
  fi

  # Nested lifecycle commands must inherit the same open file description.
  # Closing the descriptor at process exit releases locally acquired locks;
  # do not explicitly unlock an inherited descriptor here.
  export AUTO_CPUFREQ_OPERATION_LOCK_FD="$OPERATION_LOCK_FD"
  return 0
}

function manual_install {
  if command -v lsb_release > /dev/null; then
    distro="$(lsb_release -is)"
    release="$(lsb_release -rs)"
    codename="$(lsb_release -cs)"
  fi

  echo "This Linux distribution is not handled automatically by the source installer."; echo
  echo "auto-cpufreq requires Python 3.9 or newer."
  echo "Install your distro's equivalents of these source-build requirements:"
  echo "Python 3.9+ with venv, pip and development headers; setuptools; dmidecode;"
  echo "gcc; git; pkg-config; util-linux (flock); gobject-introspection; Cairo development files;"
  echo "PyGObject/GTK3 runtime or development files; and GTK3 development files."; echo
  echo "Then create an isolated virtual environment in a root-owned location,"
  echo "install the matching PyGObject runtime for your distribution, and install"
  echo "auto-cpufreq into that environment. Automatic system deployment and daemon"
  echo "integration are not available for this distribution yet."

  echo; printf "%0.s─" $(seq $COLOUMNS); echo
  echo "Consider creating a feature request to add support for your distro:"
  echo "https://github.com/AdnanHodzic/auto-cpufreq/issues/new"; echo
  echo "Make sure to include following information:"; echo
  echo "Distribution: $distro"
  echo "Release: $release"
  echo "Codename: $codename"
  echo

  exit 1
}

function os_release_matches {
  local target="$1"

  [ "${ID:-}" = "$target" ] && return 0

  case " ${ID_LIKE:-} " in
    *" $target "*) return 0;;
  esac

  return 1
}

function is_enterprise_linux {
  case "${PLATFORM_ID:-}" in
    platform:el[0-9]*) return 0;;
  esac

  os_release_matches rhel
}

function enterprise_linux_major {
  case "${PLATFORM_ID:-}" in
    platform:el[0-9]*)
      printf '%s\n' "${PLATFORM_ID#platform:el}" | sed 's/[^0-9].*$//'
      return 0
      ;;
  esac

  printf '%s\n' "${VERSION_ID%%.*}"
}

function verify_python_version {
  "$1" - <<'PYVERSION'
import sys
raise SystemExit(0 if sys.version_info >= (3, 9) else 1)
PYVERSION
}

function verify_gtk3_runtime {
  "$1" - <<'PYGTK'
import gi

gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
gi.require_version("GdkPixbuf", "2.0")

from gi.repository import Gdk, GdkPixbuf, Gio, GLib, Gtk, Pango
PYGTK
}

function source_install_preflight {
  local daemon_remove="$AUTO_CPUFREQ_FILE-remove"

  if [ -f "$daemon_remove" ] || [ -f "$POWER_STATE_SNAPSHOT" ]; then
    echo "Error: An auto-cpufreq daemon installation or recovery snapshot is still present."
    echo "Remove the daemon first with 'sudo auto-cpufreq --remove', then rerun the source installer."
    echo "For normal stable source upgrades, prefer 'sudo auto-cpufreq --update'."
    return 1
  fi

  return 0
}

function install_el_pygobject {
  local venv_python="$1"
  local glib_version
  local pygobject_spec

  if ! command -v pkg-config > /dev/null 2>&1; then
    echo "Error: pkg-config is required to select a PyGObject version compatible with this EL host."
    return 1
  fi

  glib_version="$(pkg-config --modversion glib-2.0 2>/dev/null)" || {
    echo "Error: Unable to determine the installed GLib version."
    return 1
  }

  if printf '%s\n%s\n' "2.64" "$glib_version" | sort -V -C; then
    pygobject_spec='PyGObject>=3.46,<3.50'
  elif printf '%s\n%s\n' "2.56" "$glib_version" | sort -V -C; then
    pygobject_spec='PyGObject>=3.44.2,<3.46'
  else
    echo "Error: GLib $glib_version is too old for the supported PyGObject compatibility path."
    return 1
  fi

  if ! "$venv_python" -m pip install pycairo "$pygobject_spec"; then
    echo "Error: Failed to install a PyGObject build compatible with GLib $glib_version."
    return 1
  fi

  return 0
}

function tool_install {
  echo

  function detected_distro {
    header "Detected $1 distribution"
    header "Setting up Python environment"
  }

  source_install_preflight || return 1

  # Distro-provided PyGObject bindings are tied to the distro interpreter.
  # Do not choose an unrelated python3 from PATH for these package paths.
  PYTHON_BIN="/usr/bin/python3"
  DISTRO_FAMILY=""
  USE_SYSTEM_PYGOBJECT=0

  if [ -r /etc/os-release ]; then
    . /etc/os-release
  elif [ -r /usr/lib/os-release ]; then
    . /usr/lib/os-release
  fi

  if [ "${ID:-}" = "nixos" ]; then
    echo "NixOS detected"
    echo "This installer is not supported on NixOS."
    echo "Please refer to the install instructions for NixOS at https://github.com/AdnanHodzic/auto-cpufreq#nixos"
    exit 1

  elif [ -f /etc/debian_version ] || os_release_matches debian; then
    detected_distro "Debian based"
    DISTRO_FAMILY="debian"
    USE_SYSTEM_PYGOBJECT=1
    PYTHON_BIN="/usr/bin/python3"
    VERSION="${VERSION_ID:-unknown}"
    [ -r /etc/debian_version ] && VERSION="$(cat /etc/debian_version)"

    if [ ! -x "$PYTHON_BIN" ] || ! verify_python_version "$PYTHON_BIN"; then
      echo "Error: auto-cpufreq requires Python 3.9 or newer from the distribution."
      return 1
    fi

    if ! apt-get update; then
      echo "Error: Failed to update package lists."
      return 1
    fi
    if ! apt-get check; then
      echo "Error: APT reports broken or inconsistent package dependencies."
      echo "Repair the package-manager state and run the installer again."
      return 1
    fi

    echo "Installing Debian/Ubuntu dependencies for version $VERSION..."
    echo '---- '
    if ! apt-get install -y \
      python3-dev python3-venv python3-setuptools \
      dmidecode gcc git python3-gi gir1.2-gtk-3.0; then
      echo "Error: Failed to install required system dependencies."
      return 1
    fi

  elif [ -f /etc/redhat-release ] || os_release_matches rhel || os_release_matches fedora; then
    detected_distro "RedHat based"
    DISTRO_FAMILY="redhat"

    if command -v dnf > /dev/null 2>&1; then
      RPM_PM="dnf"
    elif command -v yum > /dev/null 2>&1; then
      RPM_PM="yum"
    else
      echo "Error: Neither dnf nor yum is available to install RPM dependencies."
      return 1
    fi

    if is_enterprise_linux; then
      EL_MAJOR="$(enterprise_linux_major)"
      case "$EL_MAJOR" in
        8)
          PYTHON_BIN="/usr/bin/python3.9"
          RPM_PYTHON_PACKAGES=(python39 python39-devel python39-pip)
          ;;
        9|10)
          PYTHON_BIN="/usr/bin/python3"
          RPM_PYTHON_PACKAGES=(python3 python3-devel python3-pip)
          ;;
        *)
          echo "Error: Unsupported Enterprise Linux major version '$EL_MAJOR'."
          return 1
          ;;
      esac

      if ! "$RPM_PM" install -y "${RPM_PYTHON_PACKAGES[@]}" \
        dmidecode gcc git pkgconf-pkg-config glib2-devel cairo-devel \
        gobject-introspection-devel cairo-gobject-devel gtk3-devel; then
        echo "Error: Failed to install required Enterprise Linux dependencies."
        return 1
      fi
    else
      USE_SYSTEM_PYGOBJECT=1
      PYTHON_BIN="/usr/bin/python3"
      if ! "$RPM_PM" install -y \
        python3 python3-devel python3-pip python3-gobject \
        dmidecode gcc git pkgconf-pkg-config gtk3; then
        echo "Error: Failed to install required Fedora dependencies."
        return 1
      fi
    fi

  elif [ -f /etc/solus-release ] || [ "${ID:-}" = "solus" ]; then
    detected_distro "Solus"
    DISTRO_FAMILY="solus"
    USE_SYSTEM_PYGOBJECT=1
    PYTHON_BIN="/usr/bin/python3"
    if ! eopkg install pip python3 python3-devel python-gobject python-cairo \
      dmidecode gobject-introspection-devel libcairo-devel gcc git libgtk-3; then
      echo "Error: Failed to install required system dependencies."
      return 1
    fi
    if ! eopkg install -c system.devel; then
      echo "Error: Failed to install required system dependencies."
      return 1
    fi

  elif [ -f /etc/arch-release ] || [ "${ID:-}" = "artix" ] || os_release_matches arch; then
    detected_distro "Arch Linux based"
    DISTRO_FAMILY="arch"
    USE_SYSTEM_PYGOBJECT=1
    PYTHON_BIN="/usr/bin/python3"
    if ! pacman -S --noconfirm --needed \
      python python-pip python-setuptools python-gobject python-cairo \
      base-devel dmidecode gobject-introspection gtk3 gcc git pkgconf; then
      echo "Error: Failed to install required system dependencies."
      return 1
    fi

  elif [ "${ID:-}" = "opensuse-leap" ] || [ "${ID:-}" = "opensuse-tumbleweed" ] || os_release_matches suse || os_release_matches opensuse; then
    detected_distro "OpenSUSE"
    DISTRO_FAMILY="suse"
    USE_SYSTEM_PYGOBJECT=1
    PYTHON_BIN="/usr/bin/python3"
    if ! zypper install -y \
      python3 python3-pip python3-setuptools python3-devel python3-gobject python3-cairo \
      gcc git pkg-config dmidecode gobject-introspection-devel gtk3 gtk3-devel; then
      echo "Error: Failed to install required system dependencies."
      return 1
    fi

  elif [ "${ID:-}" = "void" ]; then
    detected_distro "Void Linux"
    DISTRO_FAMILY="void"
    USE_SYSTEM_PYGOBJECT=1
    PYTHON_BIN="/usr/bin/python3"
    if ! xbps-install -Sy \
      python3 python3-pip python3-devel python3-setuptools python3-gobject python3-cairo \
      base-devel dmidecode cairo-devel gobject-introspection gcc git gtk+3 pkg-config; then
      echo "Error: Failed to install required system dependencies."
      return 1
    fi

  else
    manual_install
  fi

  if [ ! -x "$PYTHON_BIN" ]; then
    echo "Error: The distribution Python interpreter is unavailable at $PYTHON_BIN."
    return 1
  fi
  if ! verify_python_version "$PYTHON_BIN"; then
    echo "Error: auto-cpufreq requires Python 3.9 or newer."
    return 1
  fi

  if [ "$USE_SYSTEM_PYGOBJECT" -eq 1 ] && ! verify_gtk3_runtime "$PYTHON_BIN"; then
    echo "Error: The distribution PyGObject GTK3 runtime could not be loaded."
    return 1
  fi

  header "Installing necessary Python packages"

  venv_dir="$VENV_PATH/venv"
  if ! mkdir -p "$VENV_PATH"; then
    echo "Error: Failed to create the auto-cpufreq virtual environment directory."
    return 1
  fi

  if [ "$USE_SYSTEM_PYGOBJECT" -eq 1 ]; then
    if ! "$PYTHON_BIN" -m venv --system-site-packages "$venv_dir"; then
      echo "Error: Failed to create the Python virtual environment."
      return 1
    fi
  else
    if ! "$PYTHON_BIN" -m venv "$venv_dir"; then
      echo "Error: Failed to create the Python virtual environment."
      return 1
    fi
  fi

  venv_python="$venv_dir/bin/python"
  if [ ! -x "$venv_python" ]; then
    echo "Error: Python executable was not created in the virtual environment."
    return 1
  fi
  if ! "$venv_python" -m pip --version > /dev/null 2>&1; then
    echo "Error: pip is unavailable in the Python virtual environment."
    return 1
  fi
  if ! "$venv_python" -m pip install --upgrade pip wheel; then
    echo "Error: Failed to install Python build dependencies."
    return 1
  fi

  if [ "$USE_SYSTEM_PYGOBJECT" -eq 0 ]; then
    install_el_pygobject "$venv_python" || return 1
  fi

  if ! verify_gtk3_runtime "$venv_python"; then
    echo "Error: The virtual environment cannot load the required PyGObject GTK3 runtime."
    return 1
  fi

  header "Installing auto-cpufreq tool"

  # Do not mutate global Git safe.directory here. Normal sudo invocations keep
  # SUDO_UID for Git's ownership check; unusual ownership should be fixed
  # explicitly rather than leaving a persistent global exception.
  if ! "$venv_python" -m pip install .; then
    echo "Error: Failed to install auto-cpufreq into the virtual environment."
    return 1
  fi

  if ! mkdir -p "$SHARE_DIR"; then
    echo "Error: Failed to create auto-cpufreq shared data directory."
    return 1
  fi
  if ! cp -r scripts/ "$SHARE_DIR" || ! cp -r images/ "$SHARE_DIR"; then
    echo "Error: Failed to install auto-cpufreq shared resources."
    return 1
  fi
  if ! mkdir -p "$(dirname "$IMG_FILE")" || ! cp images/icon.png "$IMG_FILE"; then
    echo "Error: Failed to install auto-cpufreq icon."
    return 1
  fi
  if ! mkdir -p "$(dirname "$ORG_FILE")" || ! cp "scripts/$(basename "$ORG_FILE")" "$(dirname "$ORG_FILE")"; then
    echo "Error: Failed to install auto-cpufreq PolicyKit policy."
    return 1
  fi

  if ! cp scripts/auto-cpufreq-venv-wrapper "$AUTO_CPUFREQ_FILE" || ! chmod a+x "$AUTO_CPUFREQ_FILE"; then
    echo "Error: Failed to install auto-cpufreq command wrapper."
    return 1
  fi
  if ! cp scripts/start_app "$AUTO_CPUFREQ_GTK_FILE" || ! chmod a+x "$AUTO_CPUFREQ_GTK_FILE"; then
    echo "Error: Failed to install auto-cpufreq GTK launcher."
    return 1
  fi

  if command -v desktop-file-install > /dev/null 2>&1; then
    if ! desktop-file-install --dir="$APPLICATIONS_PATH" "scripts/$AUTO_CPUFREQ_GTK_DESKTOP_FILE"; then
      echo "Error: Failed to install the auto-cpufreq desktop entry."
      return 1
    fi
  else
    echo "Warning: desktop-file-install is not available; skipping desktop menu integration."
    echo "The GTK interface can still be launched with auto-cpufreq-gtk."
  fi

  if command -v update-desktop-database > /dev/null 2>&1; then
    if ! update-desktop-database "$APPLICATIONS_PATH"; then
      echo "Warning: Failed to refresh the desktop application database."
    fi
  fi

  # If an old on-demand run left this helper behind, synchronize it with the
  # newly installed source version. Daemon installs create the helper as needed.
  if [ -f "$CPUFREQCTL_FILE" ]; then
    if ! cp scripts/cpufreqctl.sh "$CPUFREQCTL_FILE" || ! chmod 755 "$CPUFREQCTL_FILE"; then
      echo "Error: Failed to synchronize the auto-cpufreq cpufreqctl helper."
      return 1
    fi
  fi

  header "auto-cpufreq tool successfully installed"
  echo "For list of options, run:"
  echo "auto-cpufreq --help"; echo
}

function tool_remove {
  local cleanup_failed=0

  function remove_directory {
    local path="$1"
    [ -d "$path" ] || return 0
    if ! rm -rf -- "$path"; then
      echo "Error: Failed to remove directory: $path"
      return 1
    fi
    return 0
  }

  function remove_file {
    local path="$1"
    if [ ! -e "$path" ] && [ ! -L "$path" ]; then
      return 0
    fi
    if ! rm -f -- "$path"; then
      echo "Error: Failed to remove file: $path"
      return 1
    fi
    return 0
  }

  daemon_install="$AUTO_CPUFREQ_FILE-install"
  daemon_remove="$AUTO_CPUFREQ_FILE-remove"
  venv_python="$VENV_PATH/venv/bin/python"
  venv_entrypoint="$VENV_PATH/venv/bin/auto-cpufreq"

  if [ -f "$daemon_remove" ] || [ -f "$POWER_STATE_SNAPSHOT" ]; then
    if [ -x "$AUTO_CPUFREQ_FILE" ]; then
      if ! "$AUTO_CPUFREQ_FILE" --remove; then
        echo "Error: Failed to remove the installed auto-cpufreq daemon or restore its saved power state."
        echo "The source installation was left in place so removal can be retried."
        return 1
      fi
    elif [ -x "$venv_python" ] && [ -f "$venv_entrypoint" ]; then
      if ! PYTHONPATH="$VENV_PATH" "$venv_python" "$venv_entrypoint" --remove; then
        echo "Error: Failed to remove auto-cpufreq or restore its saved power state using the virtual environment."
        echo "The source installation was left in place so removal can be retried."
        return 1
      fi
    else
      echo "Error: auto-cpufreq has daemon or power-state cleanup pending, but no runnable command was found."
      echo "The source installation was left in place to avoid losing the recovery path."
      return 1
    fi
  else
    echo
    echo "auto-cpufreq daemon is not installed and no power-state restoration is pending; skipping daemon removal."
  fi

  remove_directory "$SHARE_DIR" || cleanup_failed=1
  remove_file "$daemon_install" || cleanup_failed=1
  remove_file "$daemon_remove" || cleanup_failed=1
  remove_file "$AUTO_CPUFREQ_FILE" || cleanup_failed=1
  remove_file "$AUTO_CPUFREQ_GTK_FILE" || cleanup_failed=1
  remove_file "$IMG_FILE" || cleanup_failed=1
  remove_file "$ORG_FILE" || cleanup_failed=1
  remove_file "$CPUFREQCTL_FILE" || cleanup_failed=1
  remove_file "$AUTO_CPUFREQ_STATS_FILE" || cleanup_failed=1
  remove_file "$APPLICATIONS_PATH/$AUTO_CPUFREQ_GTK_DESKTOP_FILE" || cleanup_failed=1

  if command -v update-desktop-database > /dev/null 2>&1; then
    if ! update-desktop-database "$APPLICATIONS_PATH"; then
      echo "Warning: Failed to refresh the desktop application database."
    fi
  fi

  remove_directory "$VENV_PATH" || cleanup_failed=1

  if [ "$cleanup_failed" -ne 0 ]; then
    echo
    echo "Error: auto-cpufreq removal completed with filesystem cleanup failures."
    echo "Some files may remain. Review the errors above and retry removal."
    echo
    return 1
  fi

  echo
  echo "auto-cpufreq tool and all its supporting files successfully removed"
  echo
  return 0
}

if ((EUID != 0)); then
  echo
  echo "Must be run as root (for example: 'sudo bash ./auto-cpufreq-installer')."
  echo
  exit 1
fi

if [[ -z "${1:-}" ]]; then ask_operation
else
  case "$1" in
    --install) answer="i";;
    --remove) answer="r";;
    *) ask_operation;;
  esac
fi

acquire_operation_lock || exit 1

case $answer in
  I|i) tool_install;;
  R|r) tool_remove;;
  *)
    echo "Unknown key, aborting ..."; echo
    exit 1
  ;;
esac
