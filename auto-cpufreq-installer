#!/usr/bin/env bash

# auto-cpufreq-installer:
# auto-cpufreq source code based installer

cd "$(dirname "$(readlink -f "$0")")" || exit 1

COLOUMNS="`tput cols`"
MID="$((COLOUMNS / 2))"

APPLICATIONS_PATH="/usr/share/applications"
INSTALL_ROOT="/opt/auto-cpufreq"
RELEASES_PATH="$INSTALL_ROOT/releases"
CURRENT_PATH="$INSTALL_ROOT/current"
LEGACY_VENV_PATH="$INSTALL_ROOT/venv"
POWER_STATE_SNAPSHOT="/var/lib/auto-cpufreq/power-state.json"
OPERATION_LOCK_PATH="/run/lock/auto-cpufreq.lock"
CPUFREQCTL_FILE="/usr/local/bin/cpufreqctl.auto-cpufreq"
AUTO_CPUFREQ_STATS_FILE="/var/run/auto-cpufreq.stats"

LEGACY_SHARE_DIR="/usr/local/share/auto-cpufreq"

AUTO_CPUFREQ_FILE="/usr/local/bin/auto-cpufreq"
AUTO_CPUFREQ_GTK_FILE=$AUTO_CPUFREQ_FILE-gtk
AUTO_CPUFREQ_GTK_DESKTOP_FILE="$(basename "$AUTO_CPUFREQ_GTK_FILE").desktop"

IMG_FILE="/usr/share/pixmaps/auto-cpufreq.png"
ORG_FILE="/usr/share/polkit-1/actions/org.auto-cpufreq.pkexec.policy"

function header {
  echo
  printf "%0.s─" $(seq $((MID-(${#1}/2)-2)))
  printf " $1 "
  printf "%0.s─" $(seq $((MID-(${#1}/2)-2)))
  echo; echo
}

function ask_operation {
  header "auto-cpufreq installer"
  echo "Welcome to auto-cpufreq tool installer."; echo
  read -p "Select a key [I]nstall/[R]emove or press ctrl+c to quit: " answer
}

function acquire_operation_lock {
  local inherited_fd="${AUTO_CPUFREQ_OPERATION_LOCK_FD:-}"
  local lock_directory
  local lock_directory_mode
  local lock_directory_mode_decimal
  local lock_info
  local inherited_info
  local temporary_lock

  if ! command -v flock > /dev/null 2>&1 \
    || ! command -v mktemp > /dev/null 2>&1 \
    || ! command -v stat > /dev/null 2>&1; then
    echo "Error: flock, mktemp and stat are required to coordinate auto-cpufreq operations."
    return 1
  fi

  lock_directory="$(dirname "$OPERATION_LOCK_PATH")"
  if ! mkdir -p "$lock_directory" \
    || [ -L "$lock_directory" ] \
    || [ ! -d "$lock_directory" ]; then
    echo "Error: Unable to use the auto-cpufreq operation lock directory."
    return 1
  fi
  if [ "$(stat -Lc '%u' "$lock_directory" 2>/dev/null)" != "0" ]; then
    echo "Error: The auto-cpufreq operation lock directory is not root-owned."
    return 1
  fi
  lock_directory_mode="$(stat -Lc '%a' "$lock_directory" 2>/dev/null)" \
    || return 1
  lock_directory_mode_decimal=$((8#$lock_directory_mode))
  if (( (lock_directory_mode_decimal & 0022) != 0 \
    && (lock_directory_mode_decimal & 01000) == 0 )); then
    echo "Error: The auto-cpufreq operation lock directory is writable without sticky protection."
    return 1
  fi

  # Publish a new lock inode without following or replacing an existing path.
  # In a sticky shared /run/lock, a root-owned canonical file then cannot be
  # swapped by an unprivileged process between validation and open.
  if [ ! -e "$OPERATION_LOCK_PATH" ] && [ ! -L "$OPERATION_LOCK_PATH" ]; then
    temporary_lock="$(mktemp "${OPERATION_LOCK_PATH}.tmp.XXXXXX")" || {
      echo "Error: Unable to create the auto-cpufreq operation lock."
      return 1
    }
    chmod 600 "$temporary_lock" || {
      rm -f -- "$temporary_lock"
      return 1
    }
    if ! ln -- "$temporary_lock" "$OPERATION_LOCK_PATH" 2>/dev/null \
      && [ ! -e "$OPERATION_LOCK_PATH" ] \
      && [ ! -L "$OPERATION_LOCK_PATH" ]; then
      rm -f -- "$temporary_lock"
      echo "Error: Unable to publish the auto-cpufreq operation lock."
      return 1
    fi
    rm -f -- "$temporary_lock"
  fi

  if [ -L "$OPERATION_LOCK_PATH" ] || [ ! -f "$OPERATION_LOCK_PATH" ]; then
    echo "Error: The auto-cpufreq operation lock is not a regular file."
    return 1
  fi
  lock_info="$(stat -Lc '%u:%a:%d:%i' "$OPERATION_LOCK_PATH" 2>/dev/null)" \
    || return 1
  case "$lock_info" in
    0:600:*) ;;
    *)
      echo "Error: The auto-cpufreq operation lock is not a secure root-owned file."
      return 1
      ;;
  esac

  if [ -n "$inherited_fd" ]; then
    case "$inherited_fd" in
      *[!0-9]*|'')
        echo "Error: The inherited auto-cpufreq operation lock is invalid."
        return 1
        ;;
    esac
    if [ ! -f "/proc/$$/fd/$inherited_fd" ]; then
      echo "Error: The inherited auto-cpufreq operation lock is invalid."
      return 1
    fi
    inherited_info="$(stat -Lc '%u:%a:%d:%i' "/proc/$$/fd/$inherited_fd" 2>/dev/null)" \
      || return 1
    if [ "$inherited_info" != "$lock_info" ]; then
      echo "Error: The inherited auto-cpufreq operation lock does not match $OPERATION_LOCK_PATH."
      return 1
    fi
    if ! flock -n "$inherited_fd"; then
      echo "Error: The inherited auto-cpufreq operation lock is not held."
      return 1
    fi
    OPERATION_LOCK_FD="$inherited_fd"
  else
    if ! exec {OPERATION_LOCK_FD}>>"$OPERATION_LOCK_PATH"; then
      echo "Error: Unable to open the auto-cpufreq operation lock."
      return 1
    fi
    inherited_info="$(stat -Lc '%u:%a:%d:%i' "/proc/$$/fd/$OPERATION_LOCK_FD" 2>/dev/null)"
    if [ "$inherited_info" != "$lock_info" ]; then
      echo "Error: The opened auto-cpufreq operation lock changed during validation."
      exec {OPERATION_LOCK_FD}>&-
      return 1
    fi
    if ! flock -n "$OPERATION_LOCK_FD"; then
      echo "Error: Another auto-cpufreq source installer operation is already in progress."
      exec {OPERATION_LOCK_FD}>&-
      return 1
    fi
  fi

  # Nested lifecycle commands must inherit the same open file description.
  # Closing the descriptor at process exit releases locally acquired locks;
  # do not explicitly unlock an inherited descriptor here.
  export AUTO_CPUFREQ_OPERATION_LOCK_FD="$OPERATION_LOCK_FD"
  return 0
}

function manual_install {
  if command -v lsb_release > /dev/null; then
    distro="$(lsb_release -is)"
    release="$(lsb_release -rs)"
    codename="$(lsb_release -cs)"
  fi

  echo "This Linux distribution is not handled automatically by the source installer."; echo
  echo "auto-cpufreq requires Python 3.9 or newer."
  echo "Install your distro's equivalents of these source-build requirements:"
  echo "Python 3.9+ with venv, pip and development headers; setuptools; dmidecode;"
  echo "gcc; git; pkg-config; util-linux (flock); gobject-introspection; Cairo development files;"
  echo "PyGObject/GTK3 runtime or development files; and GTK3 development files."; echo
  echo "Then create an isolated virtual environment in a root-owned location,"
  echo "install the matching PyGObject runtime for your distribution, and install"
  echo "auto-cpufreq into that environment. Automatic system deployment and daemon"
  echo "integration are not available for this distribution yet."

  echo; printf "%0.s─" $(seq $COLOUMNS); echo
  echo "Consider creating a feature request to add support for your distro:"
  echo "https://github.com/AdnanHodzic/auto-cpufreq/issues/new"; echo
  echo "Make sure to include following information:"; echo
  echo "Distribution: $distro"
  echo "Release: $release"
  echo "Codename: $codename"
  echo

  exit 1
}

function os_release_matches {
  local target="$1"

  [ "${ID:-}" = "$target" ] && return 0

  case " ${ID_LIKE:-} " in
    *" $target "*) return 0;;
  esac

  return 1
}

function is_enterprise_linux {
  case "${PLATFORM_ID:-}" in
    platform:el[0-9]*) return 0;;
  esac

  os_release_matches rhel
}

function enterprise_linux_major {
  case "${PLATFORM_ID:-}" in
    platform:el[0-9]*)
      printf '%s\n' "${PLATFORM_ID#platform:el}" | sed 's/[^0-9].*$//'
      return 0
      ;;
  esac

  printf '%s\n' "${VERSION_ID%%.*}"
}

function verify_python_version {
  "$1" - <<'PYVERSION'
import sys
raise SystemExit(0 if sys.version_info >= (3, 9) else 1)
PYVERSION
}

function verify_gtk3_runtime {
  "$1" - <<'PYGTK'
import gi

gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
gi.require_version("GdkPixbuf", "2.0")

from gi.repository import Gdk, GdkPixbuf, Gio, GLib, Gtk, Pango
PYGTK
}

function source_install_preflight {
  local install_mode="${1:-activate}"
  local daemon_install="$AUTO_CPUFREQ_FILE-install"
  local daemon_remove="$AUTO_CPUFREQ_FILE-remove"

  # Preparing an immutable candidate does not touch the running release or
  # daemon artifacts. Activation performs the lifecycle-sensitive checks.
  [ "$install_mode" = "prepare" ] && return 0

  if [ -e "$daemon_install" ] || [ -L "$daemon_install" ] \
    || [ -e "$daemon_remove" ] || [ -L "$daemon_remove" ] \
    || [ -e "$POWER_STATE_SNAPSHOT" ] || [ -L "$POWER_STATE_SNAPSHOT" ]; then
    echo "Error: An auto-cpufreq daemon installation or recovery snapshot is still present."
    echo "Remove the daemon first with 'sudo auto-cpufreq --remove', then rerun the source installer."
    echo "For normal stable source upgrades, prefer 'sudo auto-cpufreq --update'."
    return 1
  fi

  return 0
}

function install_el_pygobject {
  local venv_python="$1"
  local glib_version
  local pygobject_spec

  if ! command -v pkg-config > /dev/null 2>&1; then
    echo "Error: pkg-config is required to select a PyGObject version compatible with this EL host."
    return 1
  fi

  glib_version="$(pkg-config --modversion glib-2.0 2>/dev/null)" || {
    echo "Error: Unable to determine the installed GLib version."
    return 1
  }

  if printf '%s\n%s\n' "2.64" "$glib_version" | sort -V -C; then
    pygobject_spec='PyGObject>=3.46,<3.50'
  elif printf '%s\n%s\n' "2.56" "$glib_version" | sort -V -C; then
    pygobject_spec='PyGObject>=3.44.2,<3.46'
  else
    echo "Error: GLib $glib_version is too old for the supported PyGObject compatibility path."
    return 1
  fi

  if ! "$venv_python" -m pip install pycairo "$pygobject_spec"; then
    echo "Error: Failed to install a PyGObject build compatible with GLib $glib_version."
    return 1
  fi

  return 0
}

function ensure_source_layout {
  local path

  for path in "$INSTALL_ROOT" "$RELEASES_PATH"; do
    if [ -L "$path" ]; then
      echo "Error: Refusing to use a symbolic link as a source installation directory: $path"
      return 1
    fi
    if ! mkdir -p "$path" || [ ! -d "$path" ]; then
      echo "Error: Unable to create the source installation directory: $path"
      return 1
    fi
    if [ "$(stat -Lc '%u' "$path" 2>/dev/null)" != "0" ]; then
      echo "Error: The source installation directory is not root-owned: $path"
      return 1
    fi
    if ! chmod 755 "$path"; then
      echo "Error: Unable to secure the source installation directory: $path"
      return 1
    fi
  done
}

function source_revision {
  local revision="${AUTO_CPUFREQ_INSTALL_REVISION:-}"

  if [ -n "$revision" ]; then
    case "$revision" in
      *[!0-9a-fA-F]*|???????????????????????????????????????|?????????????????????????????????????????*)
        echo "Error: The requested source revision must be an exact 40-character Git SHA." >&2
        return 1
        ;;
    esac
    printf '%s\n' "${revision,,}"
    return 0
  fi

  revision="$(git rev-parse --verify HEAD 2>/dev/null || true)"
  case "$revision" in
    [0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F]*)
      if [ "${#revision}" -eq 40 ]; then
        printf '%s\n' "${revision,,}"
        return 0
      fi
      ;;
  esac

  revision="$($PYTHON_BIN - .git_archival.json 2>/dev/null <<'PYREVISION'
import json
import re
import sys

try:
    with open(sys.argv[1], encoding="utf-8") as source:
        revision = json.load(source).get("hash-full", "")
except (OSError, ValueError, AttributeError):
    raise SystemExit(1)

if not re.fullmatch(r"[0-9a-fA-F]{40}", revision):
    raise SystemExit(1)
print(revision.lower())
PYREVISION
  )" || revision=""

  if [ -n "$revision" ]; then
    printf '%s\n' "$revision"
  else
    # Unexpanded third-party source archives still receive an isolated,
    # immutable generation; only the human-readable directory prefix differs.
    printf '%s\n' "source"
  fi
}

function remove_prepared_release {
  local release_dir="$1"

  if [ "$(dirname "$release_dir")" != "$RELEASES_PATH" ] \
    || [ -L "$release_dir" ]; then
    echo "Error: Refusing to remove an unmanaged release path: $release_dir"
    return 1
  fi
  rm -rf -- "$release_dir"
}

function build_source_release {
  local revision
  local release_dir
  local release_share
  local venv_dir
  local venv_python

  ensure_source_layout || return 1
  revision="$(source_revision)" || return 1
  release_dir="$(mktemp -d "$RELEASES_PATH/$revision.XXXXXXXX")" || {
    echo "Error: Failed to allocate an immutable source release directory."
    return 1
  }
  chmod 755 "$release_dir" || {
    remove_prepared_release "$release_dir"
    return 1
  }

  venv_dir="$release_dir/venv"
  if [ "$USE_SYSTEM_PYGOBJECT" -eq 1 ]; then
    if ! "$PYTHON_BIN" -m venv --system-site-packages "$venv_dir"; then
      echo "Error: Failed to create the Python virtual environment."
      remove_prepared_release "$release_dir"
      return 1
    fi
  else
    if ! "$PYTHON_BIN" -m venv "$venv_dir"; then
      echo "Error: Failed to create the Python virtual environment."
      remove_prepared_release "$release_dir"
      return 1
    fi
  fi

  venv_python="$venv_dir/bin/python"
  if [ ! -x "$venv_python" ]; then
    echo "Error: Python executable was not created in the virtual environment."
    remove_prepared_release "$release_dir"
    return 1
  fi
  if ! "$venv_python" -m pip --version > /dev/null 2>&1; then
    echo "Error: pip is unavailable in the Python virtual environment."
    remove_prepared_release "$release_dir"
    return 1
  fi
  if ! "$venv_python" -m pip install --upgrade pip wheel; then
    echo "Error: Failed to install Python build dependencies."
    remove_prepared_release "$release_dir"
    return 1
  fi

  if [ "$USE_SYSTEM_PYGOBJECT" -eq 0 ] \
    && ! install_el_pygobject "$venv_python"; then
    remove_prepared_release "$release_dir"
    return 1
  fi
  if ! verify_gtk3_runtime "$venv_python"; then
    echo "Error: The virtual environment cannot load the required PyGObject GTK3 runtime."
    remove_prepared_release "$release_dir"
    return 1
  fi

  # A venv contains absolute interpreter paths. Build it at its final release
  # path and never rename it after package installation.
  if ! "$venv_python" -m pip install .; then
    echo "Error: Failed to install auto-cpufreq into the virtual environment."
    remove_prepared_release "$release_dir"
    return 1
  fi

  release_share="$release_dir/share"
  if ! mkdir -p "$release_share" \
    || ! cp -r scripts/ "$release_share" \
    || ! cp -r images/ "$release_share"; then
    echo "Error: Failed to install auto-cpufreq release resources."
    remove_prepared_release "$release_dir"
    return 1
  fi

  PREPARED_RELEASE="$release_dir"
  return 0
}

function install_file_atomically {
  local source="$1"
  local destination="$2"
  local mode="$3"
  local directory
  local temporary

  directory="$(dirname "$destination")"
  if ! mkdir -p "$directory"; then
    return 1
  fi
  temporary="$(mktemp "$directory/.$(basename "$destination").XXXXXXXX")" \
    || return 1
  if ! install -m "$mode" "$source" "$temporary" \
    || ! mv -fT -- "$temporary" "$destination"; then
    rm -f -- "$temporary"
    return 1
  fi
}

function deploy_source_integration {
  local release_dir="$1"
  local release_share="$release_dir/share"

  if ! install_file_atomically \
    "$release_share/images/icon.png" "$IMG_FILE" 644; then
    echo "Error: Failed to install the auto-cpufreq icon."
    return 1
  fi
  if ! install_file_atomically \
    "$release_share/scripts/$(basename "$ORG_FILE")" "$ORG_FILE" 644; then
    echo "Error: Failed to install the auto-cpufreq PolicyKit policy."
    return 1
  fi
  if ! install_file_atomically \
    "$release_share/scripts/auto-cpufreq-venv-wrapper" "$AUTO_CPUFREQ_FILE" 755; then
    echo "Error: Failed to install the auto-cpufreq command wrapper."
    return 1
  fi
  if ! install_file_atomically \
    "$release_share/scripts/start_app" "$AUTO_CPUFREQ_GTK_FILE" 755; then
    echo "Error: Failed to install the auto-cpufreq GTK launcher."
    return 1
  fi

  if command -v desktop-file-install > /dev/null 2>&1; then
    if ! desktop-file-install --dir="$APPLICATIONS_PATH" \
      "$release_share/scripts/$AUTO_CPUFREQ_GTK_DESKTOP_FILE"; then
      echo "Error: Failed to install the auto-cpufreq desktop entry."
      return 1
    fi
  else
    echo "Warning: desktop-file-install is not available; skipping desktop menu integration."
    echo "The GTK interface can still be launched with auto-cpufreq-gtk."
  fi

  if [ -L "$CPUFREQCTL_FILE" ]; then
    echo "Error: Refusing to replace symbolic link $CPUFREQCTL_FILE."
    return 1
  fi
  if [ -f "$CPUFREQCTL_FILE" ] && ! install_file_atomically \
    "$release_share/scripts/cpufreqctl.sh" "$CPUFREQCTL_FILE" 755; then
    echo "Error: Failed to synchronize the auto-cpufreq cpufreqctl helper."
    return 1
  fi

  return 0
}

function activate_prepared_release {
  local release_dir="$1"
  local venv_python="$release_dir/venv/bin/python"
  local had_current=0

  if [ "$(dirname "$release_dir")" != "$RELEASES_PATH" ] \
    || [ -L "$release_dir" ] \
    || [ ! -d "$release_dir/share/scripts" ] \
    || [ ! -x "$venv_python" ] \
    || [ ! -f "$release_dir/venv/bin/auto-cpufreq" ]; then
    echo "Error: The prepared source release is incomplete or unmanaged."
    return 1
  fi

  if ! "$venv_python" - "$LEGACY_SHARE_DIR" <<'PYMIGRATE'
import sys
from pathlib import Path
from auto_cpufreq.installation import ensure_legacy_source_current

ensure_legacy_source_current(legacy_share=Path(sys.argv[1]))
PYMIGRATE
  then
    echo "Error: Failed to prepare the legacy source installation for migration."
    return 1
  fi

  [ -L "$CURRENT_PATH" ] && had_current=1
  if [ "$had_current" -eq 1 ] \
    && ! deploy_source_integration "$release_dir"; then
    return 1
  fi

  if ! "$venv_python" - "$release_dir" <<'PYACTIVATE'
import sys
from pathlib import Path
from auto_cpufreq.installation import activate_source_release

activate_source_release(Path(sys.argv[1]))
PYACTIVATE
  then
    echo "Error: Failed to activate the prepared source release."
    return 1
  fi

  # On a first installation there was no stable frontend to preserve. Publish
  # it only after current names a complete release, so no wrapper can point at
  # a missing environment even if deployment is interrupted.
  if [ "$had_current" -eq 0 ] \
    && ! deploy_source_integration "$release_dir"; then
    return 1
  fi

  if command -v update-desktop-database > /dev/null 2>&1; then
    if ! update-desktop-database "$APPLICATIONS_PATH"; then
      echo "Warning: Failed to refresh the desktop application database."
    fi
  fi

  return 0
}

function publish_prepared_release_path {
  local result_file="${AUTO_CPUFREQ_PREPARED_RELEASE_FILE:-}"

  if [ -z "$result_file" ] || [ -e "$result_file" ] || [ -L "$result_file" ]; then
    echo "Error: A new private result file is required for prepared source releases."
    return 1
  fi
  (umask 077; set -o noclobber; printf '%s\n' "$PREPARED_RELEASE" > "$result_file")
}

function tool_install {
  local install_mode="${AUTO_CPUFREQ_INSTALL_MODE:-full}"
  local requested_release="${AUTO_CPUFREQ_PREPARED_RELEASE:-}"

  echo

  function detected_distro {
    header "Detected $1 distribution"
    header "Setting up Python environment"
  }

  case "$install_mode" in
    full|prepare|activate) ;;
    *)
      echo "Error: Unknown internal source installation mode: $install_mode"
      return 1
      ;;
  esac

  source_install_preflight "$install_mode" || return 1

  if [ "$install_mode" = "activate" ]; then
    ensure_source_layout || return 1
    activate_prepared_release "$requested_release" || return 1
    header "auto-cpufreq tool successfully installed"
    echo "For list of options, run:"
    echo "auto-cpufreq --help"; echo
    return 0
  fi

  # Distro-provided PyGObject bindings are tied to the distro interpreter.
  # Do not choose an unrelated python3 from PATH for these package paths.
  PYTHON_BIN="/usr/bin/python3"
  DISTRO_FAMILY=""
  USE_SYSTEM_PYGOBJECT=0

  if [ -r /etc/os-release ]; then
    . /etc/os-release
  elif [ -r /usr/lib/os-release ]; then
    . /usr/lib/os-release
  fi

  if [ "${ID:-}" = "nixos" ]; then
    echo "NixOS detected"
    echo "This installer is not supported on NixOS."
    echo "Please refer to the install instructions for NixOS at https://github.com/AdnanHodzic/auto-cpufreq#nixos"
    exit 1

  elif [ -f /etc/debian_version ] || os_release_matches debian; then
    detected_distro "Debian based"
    DISTRO_FAMILY="debian"
    USE_SYSTEM_PYGOBJECT=1
    PYTHON_BIN="/usr/bin/python3"
    VERSION="${VERSION_ID:-unknown}"
    [ -r /etc/debian_version ] && VERSION="$(cat /etc/debian_version)"

    if ! apt-get update; then
      echo "Error: Failed to update package lists."
      return 1
    fi
    if ! apt-get check; then
      echo "Error: APT reports broken or inconsistent package dependencies."
      echo "Repair the package-manager state and run the installer again."
      return 1
    fi

    echo "Installing Debian/Ubuntu dependencies for version $VERSION..."
    echo '---- '
    if ! apt-get install -y \
      python3 python3-dev python3-venv python3-setuptools \
      dmidecode gcc git python3-gi gir1.2-gtk-3.0; then
      echo "Error: Failed to install required system dependencies."
      return 1
    fi

  elif [ -f /etc/redhat-release ] || os_release_matches rhel || os_release_matches fedora; then
    detected_distro "RedHat based"
    DISTRO_FAMILY="redhat"

    if command -v dnf > /dev/null 2>&1; then
      RPM_PM="dnf"
    elif command -v yum > /dev/null 2>&1; then
      RPM_PM="yum"
    else
      echo "Error: Neither dnf nor yum is available to install RPM dependencies."
      return 1
    fi

    if is_enterprise_linux; then
      EL_MAJOR="$(enterprise_linux_major)"
      case "$EL_MAJOR" in
        8)
          PYTHON_BIN="/usr/bin/python3.9"
          RPM_PYTHON_PACKAGES=(python39 python39-devel python39-pip)
          ;;
        9|10)
          PYTHON_BIN="/usr/bin/python3"
          RPM_PYTHON_PACKAGES=(python3 python3-devel python3-pip)
          ;;
        *)
          echo "Error: Unsupported Enterprise Linux major version '$EL_MAJOR'."
          return 1
          ;;
      esac

      if ! "$RPM_PM" install -y "${RPM_PYTHON_PACKAGES[@]}" \
        dmidecode gcc git pkgconf-pkg-config glib2-devel cairo-devel \
        gobject-introspection-devel cairo-gobject-devel gtk3-devel; then
        echo "Error: Failed to install required Enterprise Linux dependencies."
        return 1
      fi
    else
      USE_SYSTEM_PYGOBJECT=1
      PYTHON_BIN="/usr/bin/python3"
      if ! "$RPM_PM" install -y \
        python3 python3-devel python3-pip python3-gobject \
        dmidecode gcc git pkgconf-pkg-config gtk3; then
        echo "Error: Failed to install required Fedora dependencies."
        return 1
      fi
    fi

  elif [ -f /etc/solus-release ] || [ "${ID:-}" = "solus" ]; then
    detected_distro "Solus"
    DISTRO_FAMILY="solus"
    USE_SYSTEM_PYGOBJECT=1
    PYTHON_BIN="/usr/bin/python3"
    if ! eopkg install pip python3 python3-devel python-gobject python-cairo \
      dmidecode gobject-introspection-devel libcairo-devel gcc git libgtk-3; then
      echo "Error: Failed to install required system dependencies."
      return 1
    fi
    if ! eopkg install -c system.devel; then
      echo "Error: Failed to install required system dependencies."
      return 1
    fi

  elif [ -f /etc/arch-release ] || [ "${ID:-}" = "artix" ] || os_release_matches arch; then
    detected_distro "Arch Linux based"
    DISTRO_FAMILY="arch"
    USE_SYSTEM_PYGOBJECT=1
    PYTHON_BIN="/usr/bin/python3"
    if ! pacman -S --noconfirm --needed \
      python python-pip python-setuptools python-gobject python-cairo \
      base-devel dmidecode gobject-introspection gtk3 gcc git pkgconf; then
      echo "Error: Failed to install required system dependencies."
      return 1
    fi

  elif [ "${ID:-}" = "opensuse-leap" ] || [ "${ID:-}" = "opensuse-tumbleweed" ] || os_release_matches suse || os_release_matches opensuse; then
    detected_distro "OpenSUSE"
    DISTRO_FAMILY="suse"
    USE_SYSTEM_PYGOBJECT=1
    PYTHON_BIN="/usr/bin/python3"
    if ! zypper install -y \
      python3 python3-pip python3-setuptools python3-devel python3-gobject python3-cairo \
      gcc git pkg-config dmidecode gobject-introspection-devel gtk3 gtk3-devel; then
      echo "Error: Failed to install required system dependencies."
      return 1
    fi

  elif [ "${ID:-}" = "void" ]; then
    detected_distro "Void Linux"
    DISTRO_FAMILY="void"
    USE_SYSTEM_PYGOBJECT=1
    PYTHON_BIN="/usr/bin/python3"
    if ! xbps-install -Sy \
      python3 python3-pip python3-devel python3-setuptools python3-gobject python3-cairo \
      base-devel dmidecode cairo-devel gobject-introspection gcc git gtk+3 pkg-config; then
      echo "Error: Failed to install required system dependencies."
      return 1
    fi

  else
    manual_install
  fi

  if [ ! -x "$PYTHON_BIN" ]; then
    echo "Error: The distribution Python interpreter is unavailable at $PYTHON_BIN."
    return 1
  fi
  if ! verify_python_version "$PYTHON_BIN"; then
    echo "Error: auto-cpufreq requires Python 3.9 or newer."
    return 1
  fi

  if [ "$USE_SYSTEM_PYGOBJECT" -eq 1 ] && ! verify_gtk3_runtime "$PYTHON_BIN"; then
    echo "Error: The distribution PyGObject GTK3 runtime could not be loaded."
    return 1
  fi

  header "Installing necessary Python packages"

  header "Installing auto-cpufreq tool"

  # Do not mutate global Git safe.directory here. Normal sudo invocations keep
  # SUDO_UID for Git's ownership check; unusual ownership should be fixed
  # explicitly rather than leaving a persistent global exception.
  build_source_release || return 1

  if [ "$install_mode" = "prepare" ]; then
    if ! publish_prepared_release_path; then
      remove_prepared_release "$PREPARED_RELEASE"
      return 1
    fi
    echo "Prepared source release: $PREPARED_RELEASE"
    return 0
  fi

  activate_prepared_release "$PREPARED_RELEASE" || return 1

  header "auto-cpufreq tool successfully installed"
  echo "For list of options, run:"
  echo "auto-cpufreq --help"; echo
}

function tool_remove {
  local cleanup_failed=0

  function remove_directory {
    local path="$1"
    [ -d "$path" ] || return 0
    if ! rm -rf -- "$path"; then
      echo "Error: Failed to remove directory: $path"
      return 1
    fi
    return 0
  }

  function remove_file {
    local path="$1"
    if [ ! -e "$path" ] && [ ! -L "$path" ]; then
      return 0
    fi
    if ! rm -f -- "$path"; then
      echo "Error: Failed to remove file: $path"
      return 1
    fi
    return 0
  }

  daemon_install="$AUTO_CPUFREQ_FILE-install"
  daemon_remove="$AUTO_CPUFREQ_FILE-remove"
  venv_python="$CURRENT_PATH/venv/bin/python"
  venv_entrypoint="$CURRENT_PATH/venv/bin/auto-cpufreq"
  if [ ! -x "$venv_python" ] || [ ! -f "$venv_entrypoint" ]; then
    venv_python="$LEGACY_VENV_PATH/bin/python"
    venv_entrypoint="$LEGACY_VENV_PATH/bin/auto-cpufreq"
  fi

  if [ -e "$daemon_remove" ] || [ -L "$daemon_remove" ] \
    || [ -e "$POWER_STATE_SNAPSHOT" ] || [ -L "$POWER_STATE_SNAPSHOT" ]; then
    if [ -x "$AUTO_CPUFREQ_FILE" ]; then
      if ! "$AUTO_CPUFREQ_FILE" --remove; then
        echo "Error: Failed to remove the installed auto-cpufreq daemon or restore its saved power state."
        echo "The source installation was left in place so removal can be retried."
        return 1
      fi
    elif [ -x "$venv_python" ] && [ -f "$venv_entrypoint" ]; then
      if ! PYTHONPATH="$(dirname "$(dirname "$venv_python")")" \
        "$venv_python" "$venv_entrypoint" --remove; then
        echo "Error: Failed to remove auto-cpufreq or restore its saved power state using the virtual environment."
        echo "The source installation was left in place so removal can be retried."
        return 1
      fi
    else
      echo "Error: auto-cpufreq has daemon or power-state cleanup pending, but no runnable command was found."
      echo "The source installation was left in place to avoid losing the recovery path."
      return 1
    fi
  else
    echo
    echo "auto-cpufreq daemon is not installed and no power-state restoration is pending; skipping daemon removal."
  fi

  remove_directory "$LEGACY_SHARE_DIR" || cleanup_failed=1
  remove_file "$daemon_install" || cleanup_failed=1
  remove_file "$daemon_remove" || cleanup_failed=1
  remove_file "$AUTO_CPUFREQ_FILE" || cleanup_failed=1
  remove_file "$AUTO_CPUFREQ_GTK_FILE" || cleanup_failed=1
  remove_file "$IMG_FILE" || cleanup_failed=1
  remove_file "$ORG_FILE" || cleanup_failed=1
  remove_file "$CPUFREQCTL_FILE" || cleanup_failed=1
  remove_file "$AUTO_CPUFREQ_STATS_FILE" || cleanup_failed=1
  remove_file "$APPLICATIONS_PATH/$AUTO_CPUFREQ_GTK_DESKTOP_FILE" || cleanup_failed=1

  if command -v update-desktop-database > /dev/null 2>&1; then
    if ! update-desktop-database "$APPLICATIONS_PATH"; then
      echo "Warning: Failed to refresh the desktop application database."
    fi
  fi

  remove_directory "$INSTALL_ROOT" || cleanup_failed=1

  if [ "$cleanup_failed" -ne 0 ]; then
    echo
    echo "Error: auto-cpufreq removal completed with filesystem cleanup failures."
    echo "Some files may remain. Review the errors above and retry removal."
    echo
    return 1
  fi

  echo
  echo "auto-cpufreq tool and all its supporting files successfully removed"
  echo
  return 0
}

if ((EUID != 0)); then
  echo
  echo "Must be run as root (for example: 'sudo bash ./auto-cpufreq-installer')."
  echo
  exit 1
fi

if [[ -z "${1:-}" ]]; then ask_operation
else
  case "$1" in
    --install) answer="i";;
    --remove) answer="r";;
    *) ask_operation;;
  esac
fi

acquire_operation_lock || exit 1

case $answer in
  I|i) tool_install;;
  R|r) tool_remove;;
  *)
    echo "Unknown key, aborting ..."; echo
    exit 1
  ;;
esac
